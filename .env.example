# ─── Сервер ──────────────────────────────────────────────────────────────────
PORT=3000
# При локальном запуске можно явно ограничить сервер loopback-адресом.
HOST=127.0.0.1
# development | production — влияет на детализацию ошибок (generic errors, мера №24)
NODE_ENV=development
# IP-адреса или CIDR доверенных обратных прокси через запятую.
TRUSTED_PROXIES=

# ─── База данных (PostgreSQL) ────────────────────────────────────────────────
# Строка подключения целиком (приоритетнее, чем DB_* переменные ниже)
DATABASE_URL=postgres://postgres:ПАРОЛЬ@localhost:5432/diff_service
# Альтернатива — по частям:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=diff_service
DB_USER=postgres
DB_PASSWORD=ПАРОЛЬ
# true — требовать TLS к БД (нужно для облачных Neon/Render)
DB_SSL=false
# true — пересоздать таблицы при старте (только для разработки!)
DB_SYNC_ALTER=true

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Секреты: сгенерировать командой
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_НЕ_МЕНЕЕ_32_СИМВОЛОВ
JWT_REFRESH_SECRET=ДРУГАЯ_СЛУЧАЙНАЯ_СТРОКА_НЕ_МЕНЕЕ_32_СИМВОЛОВ
# Время жизни access-токена (короткое) и refresh-токена (длинное)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Параметры безопасности ──────────────────────────────────────────────────
# bcrypt: число раундов соли (10-12 — разумный компромисс скорость/стойкость)
BCRYPT_ROUNDS=12
# Мера №6: блокировка аккаунта после N неудачных входов на M минут
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Мера №20: максимум одновременных активных сессий (refresh-токенов) на пользователя
MAX_SESSIONS_PER_USER=3
# Мера №12: максимальный размер тела запроса
BODY_LIMIT=100kb
# Мера №22: белый список origin-ов для CORS (через запятую)
CORS_WHITELIST=http://localhost:3000,http://127.0.0.1:3000
# Мера №16: срок жизни токена сброса пароля в минутах
RESET_TOKEN_TTL_MINUTES=60
# Глобальный rate limit: окно (мин) и лимит запросов с одного IP
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
# Rate limit для /auth/login и /auth/register
AUTH_RATE_LIMIT_MAX=10
# Мера №25: rate limit на пользователя (по user id) для изменяющих операций
USER_RATE_LIMIT_MAX=60

# ─── Стартовый администратор (создаётся при первом запуске) ──────────────────
# ВНИМАНИЕ: значение с символом # обязательно берите в кавычки — иначе dotenv
# считает всё после # комментарием и пароль обрежется.
ADMIN_EMAIL=admin@diffservice.local
ADMIN_PASSWORD="Admin#2024pass"

# Опциональная телеметрия. Заполняется в окружении, не в Git.
SENTRY_DSN=
BETTER_STACK_LOGS_URL=
BETTER_STACK_SOURCE_TOKEN=
